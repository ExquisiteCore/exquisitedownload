{
  "manifest_version": 3,
  "name": "ExquisiteDownload",
  "version": "1.0.0",
  "description": "将浏览器下载转发到 edl 下载管理器",
  "permissions": [
    "downloads",
    "storage",
    "contextMenus",
    "notifications",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:6800/*",
    "http://localhost:6800/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
